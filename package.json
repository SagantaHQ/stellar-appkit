{
  "name": "saganta-stellar-appkit",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --cwd packages/core typecheck && bun run --cwd packages/core build && bun run --cwd packages/siws-verify typecheck",
    "test": "bun test",
    "test:core": "bun test --cwd packages/core",
    "test:siws-verify": "bun test --cwd packages/siws-verify",
    "version": "npm --workspaces version",
    "publish": "bun install && bun run build && npm --workspaces publish --access public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@albedo-link/intent": "^0.13.0",
    "@creit.tech/xbull-wallet-connect": "^0.4.0",
    "@ledgerhq/hw-app-str": "^7.7.7",
    "@ledgerhq/hw-transport-webhid": "^6.36.0",
    "@ledgerhq/hw-transport-webusb": "^6.35.0",
    "@stellar/freighter-api": "^4.1.0",
    "@stellar/stellar-sdk": "^13.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@walletconnect/sign-client": "^2.0.0",
    "react": "^19.0.0",
    "solid-js": "^1.8.0",
    "svelte": "^4.2.0",
    "typescript": "^7.0.2",
    "vue": "^3.4.0"
  },
  "homepage": "https://stellar-appkit.saganta.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/sagantaHQ/stellar-appkit.git"
  },
  "bugs": {
    "url": "https://github.com/sagantaHQ/stellar-appkit/issues"
  },
  "dependencies": {
    "better-qr": "^0.1.2"
  }
}
